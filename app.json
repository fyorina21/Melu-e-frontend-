{
  "expo": {
    "name": "melue-app",
    "slug": "melue-app",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "melueapp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F5F7"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      "@react-native-community/datetimepicker"
    ]
  }
}
