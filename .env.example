# ==============================================================================
# Melu-e React Native Web Frontend - Environment Configuration Example
# ==============================================================================
# Copy this file to `.env` (or `.env.local`) for your local environment:
#   cp .env.example .env
#
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# Base URL for the Rails backend API layer
# - Local development (Rails Puma server): http://localhost:3000
# - Production deployment: https://api.melue.foundation
EXPO_PUBLIC_API_URL=http://localhost:3000

# Demo Mode Toggle (optional)
# - false: Sends real HTTP payloads to EXPO_PUBLIC_API_URL
# - true: Uses local mock storage for offline demonstration
EXPO_PUBLIC_DEMO_MODE=false
